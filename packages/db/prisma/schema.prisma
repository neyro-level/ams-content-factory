generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum BrandAccessRole {
  MANAGE
  EDIT
  REVIEW
  VIEW
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeDocumentType {
  FILE
  URL
  TEXT
  NOTE
  CASE
  PRODUCT
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum ResearchInboxStatus {
  NEW
  PROCESSING
  READY
  REJECTED
  ARCHIVED
  FAILED
}

enum ResearchItemStatus {
  PENDING
  READY
  REJECTED
  ARCHIVED
  FAILED
}

enum ClaimStatus {
  UNVERIFIED
  SUPPORTED
  CONFLICTING
  REJECTED
}

enum ContentOpportunityStatus {
  NEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  CONVERTED
  ARCHIVED
}

enum ContentProjectStatus {
  IDEA
  RESEARCHING
  DRAFT
  FACT_CHECK
  REVIEW
  APPROVED
  PRODUCTION
  QC
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
  FAILED
  CANCELLED
}

enum ContentType {
  REEL
  SHORT_VIDEO
  SOCIAL_POST
  CAROUSEL
  STORY
  ARTICLE
  CASE
  EXPLAINER
}

enum ContentVersionAuthorType {
  USER
  AI
  SYSTEM
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  brandAccesses BrandAccess[]
  auditEvents   AuditLog[]   @relation("AuditActor")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String   @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  brands      Brand[]
  auditEvents AuditLog[]
  workflowRuns WorkflowRun[]

  @@map("organization")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           MembershipRole   @default(VIEWER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("membership")
}

model Brand {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  slug           String
  status         BrandStatus   @default(ACTIVE)
  timezone       String        @default("Europe/Moscow")
  locale         String        @default("ru-RU")
  websiteUrl     String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accesses       BrandAccess[]
  auditEvents    AuditLog[]
  workflowRuns   WorkflowRun[]
  profile        BrandProfile?
  voices         BrandVoice[]
  contentPillars ContentPillar[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  researchInboxItems ResearchInboxItem[]
  researchSources ResearchSource[]
  researchItems ResearchItem[]
  researchReports ResearchReport[]
  contentOpportunities ContentOpportunity[]
  claims Claim[]
  contentProjects ContentProject[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("brand")
}

model BrandProfile {
  id String @id @default(uuid()) @db.Uuid
  brandId String @unique @db.Uuid
  positioning Json? @default("{}")
  targetAudience Json? @default("{}")
  offers Json? @default("[]")
  customerProblems Json? @default("[]")
  differentiators Json? @default("[]")
  proof Json? @default("[]")
  constraints Json? @default("[]")
  forbiddenClaims Json? @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields:[brandId], references:[id], onDelete:Cascade)
  @@map("brand_profile")
}

model BrandVoice {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  language String @default("ru")
  toneSummary String
  styleRules Json?
  doRules Json?
  dontRules Json?
  lexicon Json?
  forbiddenWords Json?
  exampleTexts Json?
  ctaExamples Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  @@index([brandId, language])
  @@map("brand_voice")
}

model ContentPillar {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  name String
  description String?
  priority Int @default(0)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentProjects ContentProject[]
  @@unique([brandId, name])
  @@map("content_pillar")
}

model KnowledgeDocument {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  brandId String @db.Uuid
  title String
  type KnowledgeDocumentType
  sourceUrl String?
  sourceText String?
  status KnowledgeDocumentStatus @default(PENDING)
  checksum String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]
  @@unique([brandId, checksum])
  @@index([organizationId, brandId, status])
  @@map("knowledge_document")
}

model KnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  documentId String @db.Uuid
  ordinal Int
  content String
  tokenCount Int?
  embedding Unsupported("vector")?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, ordinal])
  @@index([brandId, documentId])
  @@map("knowledge_chunk")
}

model ResearchInboxItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  brandId String @db.Uuid
  kind String
  title String
  content String?
  sourceUrl String?
  checksum String
  status ResearchInboxStatus @default(NEW)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  @@unique([brandId, checksum])
  @@index([organizationId, brandId, status])
  @@map("research_inbox_item")
}

model ResearchSource {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  canonicalUrl String
  domain String
  sourceType String
  title String?
  author String?
  publishedAt DateTime?
  capturedAt DateTime @default(now())
  metadata Json?
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items ResearchItem[]
  @@unique([brandId, canonicalUrl])
  @@index([brandId, domain])
  @@map("research_source")
}

model ResearchItem {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  sourceId String? @db.Uuid
  title String
  summary String?
  rawContentStorageKey String?
  rawContent String?
  contentHash String
  publishedAt DateTime?
  capturedAt DateTime @default(now())
  relevanceScore Float?
  noveltyScore Float?
  status ResearchItemStatus @default(PENDING)
  metadata Json?
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source ResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  reports ResearchReport[]
  evidence Evidence[]
  @@unique([brandId, contentHash])
  @@index([brandId, status, capturedAt])
  @@map("research_item")
}

model ResearchReport {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  researchItemId String @db.Uuid
  summary String
  classification String?
  relevanceScore Float?
  noveltyScore Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  @@unique([researchItemId])
  @@index([brandId, createdAt])
  @@map("research_report")
}

model ContentOpportunity {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  pillarId String? @db.Uuid
  title String
  angle String
  whyNow String?
  audience String?
  commercialRelevance String?
  relevanceScore Float?
  noveltyScore Float?
  evidenceScore Float?
  overallScore Float?
  status ContentOpportunityStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentProjects ContentProject[]
  @@index([brandId, status, overallScore])
  @@map("content_opportunity")
}

model ContentProject {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  brandId String @db.Uuid
  pillarId String? @db.Uuid
  opportunityId String? @db.Uuid
  title String
  goal String?
  audience String?
  contentType ContentType
  status ContentProjectStatus @default(IDEA)
  priority Int @default(0)
  recipeId String?
  targetPublishAt DateTime?
  createdBy String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pillar ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  opportunity ContentOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  versions ContentVersion[]
  variants PlatformVariant[]
  approvals Approval[]
  comments EditorialComment[]
  @@index([organizationId, brandId, status, createdAt])
  @@index([opportunityId])
  @@map("content_project")
}

model ContentVersion {
  id String @id @default(uuid()) @db.Uuid
  contentProjectId String @db.Uuid
  version Int
  brief String?
  hook String?
  body String?
  cta String?
  script String?
  notes String?
  createdByType ContentVersionAuthorType
  createdByUserId String? @db.Uuid
  aiExecutionId String?
  createdAt DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  @@unique([contentProjectId, version])
  @@map("content_version")
}

model PlatformVariant {
  id String @id @default(uuid()) @db.Uuid
  contentProjectId String @db.Uuid
  platform String
  title String?
  caption String?
  description String?
  hashtags String[] @default([])
  cta String?
  mediaConfiguration Json?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  @@unique([contentProjectId, platform])
  @@map("platform_variant")
}

model Approval {
  id String @id @default(uuid()) @db.Uuid
  contentProjectId String @db.Uuid
  status String
  reviewerUserId String? @db.Uuid
  note String?
  createdAt DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  @@index([contentProjectId, createdAt])
  @@map("approval")
}

model EditorialComment {
  id String @id @default(uuid()) @db.Uuid
  contentProjectId String @db.Uuid
  authorUserId String? @db.Uuid
  body String
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  @@index([contentProjectId, createdAt])
  @@map("editorial_comment")
}

model Claim {
  id String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  contentProjectId String? @db.Uuid
  text String
  type String
  status ClaimStatus @default(UNVERIFIED)
  confidence Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  evidence Evidence[]
  @@index([brandId, status])
  @@map("claim")
}

model Evidence {
  id String @id @default(uuid()) @db.Uuid
  claimId String @db.Uuid
  researchItemId String? @db.Uuid
  sourceUrl String
  sourceTitle String?
  capturedAt DateTime @default(now())
  excerpt String
  mediaAssetId String? @db.Uuid
  confidence Float?
  metadata Json?
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  researchItem ResearchItem? @relation(fields: [researchItemId], references: [id], onDelete: SetNull)
  @@index([claimId])
  @@index([researchItemId])
  @@map("evidence")
}

model WorkflowRun {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  brandId        String?           @db.Uuid
  type           String
  status         WorkflowRunStatus @default(QUEUED)
  idempotencyKey String
  payload        Json?
  result         Json?
  error          Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand          Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([brandId, status])
  @@map("workflow_run")
}

model BrandAccess {
  id        String          @id @default(uuid()) @db.Uuid
  brandId   String          @db.Uuid
  userId    String          @db.Uuid
  role      BrandAccessRole @default(VIEW)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([brandId, userId])
  @@index([userId])
  @@map("brand_access")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  brandId        String?      @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}
