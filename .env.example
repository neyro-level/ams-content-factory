# Public application origin. A local value is safe for development only.
APP_URL=http://localhost:3000
NODE_ENV=development

# Local Docker PostgreSQL. Replace only through Doppler or the deployment environment.
DATABASE_URL=postgresql://ams_content_factory:ams_content_factory_dev_only@localhost:54329/ams_content_factory?schema=public
BETTER_AUTH_SECRET=

# Leave external provider secrets empty until their dedicated waves.
OPENAI_API_KEY=
HEYGEN_API_KEY=
MOTION_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
