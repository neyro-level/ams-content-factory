# Copy to .env only in the target environment. Never commit .env.
APP_URL=https://fabrika.ams24.ru
NODE_ENV=production
HTTP_PORT=80

# Copy the production connection string from the Timeweb Cloud DBaaS panel.
# PostgreSQL is external to docker-compose.prod.yml; do not use a Docker service hostname here.
# Keep TLS enabled and use the exact certificate/SSL settings provided by Timeweb.
DATABASE_URL=postgresql://ams_content_factory:replace_with_a_generated_password@your-timeweb-db-host:5432/ams_content_factory?schema=public&sslmode=require
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Runtime-only, read-scoped API key for the local stdio MCP process. Never expose to browser code.
MCP_API_KEY=

# Leave external provider secrets empty until their dedicated waves.
OPENAI_API_KEY=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
MOTION_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Pinned non-secret Instagram Graph API protocol version used by the provider runtime.
INSTAGRAM_GRAPH_API_VERSION=v22.0
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Pinned non-secret VK API protocol version used by the provider runtime.
VK_API_VERSION=5.199
