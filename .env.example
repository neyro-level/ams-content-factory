# Copy to .env only in the target environment. Never commit .env.
APP_URL=http://localhost:3000
NODE_ENV=development
HTTP_PORT=80

# PostgreSQL container values. Use generated values in production.
POSTGRES_DB=ams_content_factory
POSTGRES_USER=ams_content_factory
POSTGRES_PASSWORD=replace_with_a_generated_password
DATABASE_URL=postgresql://ams_content_factory:replace_with_a_generated_password@postgres:5432/ams_content_factory?schema=public
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=

# Leave external provider secrets empty until their dedicated waves.
OPENAI_API_KEY=
HEYGEN_API_KEY=
MOTION_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
