[Unit]
Description=AMS Content Factory worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amsplatform
Group=www-data
WorkingDirectory=/opt/ams-platform/ams-content-factory/current/app
EnvironmentFile=/etc/ams-platform/ams-content-factory.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/ams-platform/ams-content-factory/current/app/apps/worker/dist/worker.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/ams-platform/ams-content-factory /opt/ams-platform/ams-content-factory/shared
StandardOutput=append:/var/log/ams-platform/ams-content-factory/worker.log
StandardError=append:/var/log/ams-platform/ams-content-factory/worker.log

[Install]
WantedBy=multi-user.target
